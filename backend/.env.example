# ============================================================
# SalaryFund AI - Environment Configuration
# Copy to .env and fill in real values before deploying.
# ============================================================

ENVIRONMENT=development
DEBUG=false

# --- Security ---
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=CHANGE_ME_TO_A_LONG_RANDOM_SECRET

# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FIELD_ENCRYPTION_KEY=AlPar_YJYp6SRlCoElgINrIBSFyYB4ATAHkEnUMKO0k=

ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
OTP_EXPIRE_MINUTES=5

# --- Database ---
DATABASE_URL=postgresql+asyncpg://salaryfund:salaryfund_dev_password@postgres:5432/salaryfund_ai
DATABASE_URL_SYNC=postgresql+psycopg2://salaryfund:salaryfund_dev_password@postgres:5432/salaryfund_ai
POSTGRES_PASSWORD=salaryfund_dev_password

# --- Redis / Celery ---
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# --- CORS (comma-separated) ---
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# --- File uploads ---
MAX_UPLOAD_SIZE_MB=10
UPLOAD_DIR=/data/uploads

# --- AI model artifacts ---
MODEL_ARTIFACT_DIR=/data/ai_models
ELIGIBILITY_MODEL_VERSION=v1
FRAUD_MODEL_VERSION=v1

# --- Email (SMTP) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@salaryfund.ai

# --- SMS Gateway ---
SMS_PROVIDER_API_KEY=
SMS_PROVIDER_SENDER_ID=SALFND

# --- Rate limiting ---
RATE_LIMIT_DEFAULT=100/minute
RATE_LIMIT_AUTH=10/minute
RATE_LIMIT_OTP=5/minute
